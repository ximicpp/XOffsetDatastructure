        {
          "new_byte_end": 9024,
          "new_byte_start": 7363,
          "new_utf8": ")\n    # The unchanged run() does not reread root Q acceptance. Bind it here to the\n    # exact record copied by the unchanged formal freeze, before any host action.\n    qref = review['qualification_acceptance']\n    qpath = checked(qref)\n    need(qpath == COORD / 'qualification-acceptance.json'\n         and fid(FROZEN / 'qualification-acceptance.json') == norm(qref['identity'])\n         and request['qualification_acceptance'] == qref,\n         'root Q acceptance/current formal frozen copy/request must be identical')\n    q = read(qpath)\n    need(q['status'] == 'passed' and q['measurement_qualified'] is True and q['complete'] is True\n         and q['postrun_pin'] == Q_POSTRUN_PIN, 'root must explicitly accept this actual audited Q32')\n    expected_q = {'audit_report': COORD.parent / 'q32_freeze_preparation/Q32_OFFLINE_AUDIT_RESULT_v1.json',\n                  'queue_request': B / 'qualification-v1/queue/request.json',\n                  'queue_result': B / 'qualification-v1/queue/result.json'}\n    for name, path in expected_q.items():\n        need(checked(q[name]) == path, 'root Q evidence must name this sole actual Q32: ' + name)\n    report = read(q['audit_report']['path'])\n    need(report['status'] == 'passed' and report['campaign'] == 'qualification'\n         and report['measurement_qualified'] is True and report['complete'] is True\n         and report['successful_actual_children'] == 4656 and report['successful_primary_children'] == 2328\n         and report['budget_violations'] == [] and report['queue_result'] == q['queue_result']['identity'],\n         'actual original Q audit must be complete and qualified before formal host actions'",
          "old_byte_end": 7315,
          "old_byte_start": 7315,
          "old_utf8": "",
          "operation": "insert"
        },
