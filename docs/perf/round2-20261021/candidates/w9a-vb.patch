+        XOFFSET_DETAIL_V4_INLINE const char* checked_relative(const std::int32_t& delta,
+                                            const WireValidationContext& ctx) {
+            auto address = static_cast<std::int64_t>(reinterpret_cast<std::uintptr_t>(&delta)) + delta;
