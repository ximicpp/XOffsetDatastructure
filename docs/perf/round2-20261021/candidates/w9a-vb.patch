--- w9a/tests/test_validation_differential.cpp	1969-12-31 16:00:00
+++ w9a-vb/tests/test_validation_differential.cpp	2026-10-20 09:39:48
@@ -0,0 +1,430 @@
+// Purpose: differential test of the structural wire validator against a
+// reference copy of the original W9a validator (w9a_reference_validator.hpp).
+// S/M/L-like snapshots (the serialization_comparison record shape, plus bool,
+// map and set members) are built and mutated through the public API so that
+// they contain free-list blocks, then tens of thousands of hostile variants
+// are generated: random bit flips and byte writes, container offset/size/
+// capacity/binding edits, allocation header edits (including consistent
+// non-multiple-of-8 lengths that are accepted or rejected only by byte-exact
+// overlap reasoning), free-list edits and non-multiple-of-8 payload extents.
+// For every variant the shipped validator and the reference must agree on
+// accept/reject and on the exact exception type and text. The complete public
+// load_verified<T>() must also equal "the same pre-checks + validator".
+#define XOFFSET_VALIDATION_GRANULE_FALLBACK_HOOK 1
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <optional>
+#include <random>
+#include <string>
+#include <typeinfo>
+#include <vector>
+#include "../xoffsetdatastructure.hpp"
+#include "w9a_reference_validator.hpp"
+
+namespace dt {
+using namespace XOffsetDatastructure;
+struct Attr { XString key; XVector<std::uint8_t> value; };
+struct Record {
+    std::uint64_t id{};
+    std::uint32_t revision{};
+    std::int64_t score{};
+    XString name;
+    XVector<std::uint32_t> samples;
+    XVector<std::uint8_t> payload;
+    XVector<Attr> attrs;
+    bool flag{};
+    XMap<std::int32_t, XString> tags;
+    XSet<std::int32_t> marks;
+};
+struct Snapshot {
+    std::uint32_t schema_version{1};
+    std::uint64_t epoch{};
+    XVector<Record> records;
+};
+} // namespace dt
+XOFFSET_REGISTER_SCHEMA_NAME(dt::Snapshot, "test.validation-differential.v1")
+
+namespace {
+using namespace XOffsetDatastructure;
+namespace xd = XOffsetDatastructure::detail;
+using Root = dt::Snapshot;
+constexpr std::size_t wire_header = sizeof(XWireHeaderV1);
+
+[[noreturn]] void fail(const std::string& message) {
+    std::cerr << "test_validation_differential: " << message << '\n';
+    std::exit(1);
+}
+void need(bool ok, const std::string& message) { if (!ok) fail(message); }
+
+struct Outcome {
+    int kind = 0; // 0 accepted, 1 XException, 2 bad_alloc, 3 other std::exception, 4 unknown
+    std::string text;
+    bool operator==(const Outcome&) const = default;
+};
+std::string show(const Outcome& o) {
+    static const char* names[] = {"accepted", "XException", "bad_alloc", "std::exception", "unknown"};
+    return std::string(names[o.kind]) + ": " + o.text;
+}
+template <class F> Outcome capture(F&& f) {
+    try { f(); return {}; }
+    catch (const XException& e) { return {1, e.what()}; }
+    catch (const std::bad_alloc& e) { return {2, e.what()}; }
+    catch (const std::exception& e) { return {3, std::string(typeid(e).name()) + ": " + e.what()}; }
+    catch (...) { return {4, "unknown exception"}; }
+}
+
+template <typename T> T rd(const std::string& b, std::size_t pos) {
+    T v{}; std::memcpy(&v, b.data() + pos, sizeof(T)); return v;
+}
+template <typename T> void wr(std::string& b, std::size_t pos, const T& v) {
+    std::memcpy(b.data() + pos, &v, sizeof(T));
+}
+
+// Same checks and order as XBuffer::load_verified_with_resource, ending at the
+// constructed buffer and root just before verify_structural_wire_graph.
+struct Prepared { XBuffer xbuf; const Root* root{}; };
+std::optional<Prepared> prepare(const std::string& wire, Outcome& precheck) {
+    std::optional<Prepared> result;
+    precheck = capture([&] {
+        if (wire.size() < sizeof(XWireHeaderV1)) throw XException("load_verified<T>(): wire header too small");
+        XWireHeaderV1 header{};
+        std::memcpy(&header, wire.data(), sizeof(header));
+        if (!wire_magic_matches_v1(header.magic)) throw XException("load_verified<T>(): bad magic");
+        if (header.format_major != XWIRE_FORMAT_MAJOR_V1 || header.format_minor != XWIRE_FORMAT_MINOR_V1)
+            throw XException("load_verified<T>(): unsupported format version");
+        if (header.header_size != sizeof(XWireHeaderV1)) throw XException("load_verified<T>(): header size mismatch");
+        if (header.endian_tag != XWIRE_ENDIAN_TAG_V1) throw XException("load_verified<T>(): endian tag mismatch");
+        if (header.flags != XWIRE_FLAGS_V1) throw XException("load_verified<T>(): unsupported flags");
+        if (header.root_type_id != xd::wire_root_type_id<Root>()) throw XException("load_verified<T>(): root type id mismatch");
+        if (header.schema_hash_lo != xd::wire_schema_hash<Root>() || header.schema_hash_hi != 0)
+            throw XException("load_verified<T>(): schema hash mismatch");
+        if (header.used_bytes != wire.size() - sizeof(XWireHeaderV1)) throw XException("load_verified<T>(): used size mismatch");
+        if (header.reserved_bytes < header.used_bytes || header.reserved_bytes > XBufferCore::MAX_PAYLOAD ||
+            header.used_bytes > XBufferCore::MAX_PAYLOAD)
+            throw XException("load_verified<T>(): invalid payload or reservation size");
+        if (header.crc32c != 0 || header.reserved0 != 0)
+            throw XException("load_verified<T>(): unsupported reserved header fields");
+        if (header.root_offset >= header.used_bytes) throw XException("load_verified<T>(): root offset out of bounds");
+        if (header.allocator_offset >= header.used_bytes) throw XException("load_verified<T>(): allocator offset out of bounds");
+        XBuffer xbuf(wire.data() + sizeof(XWireHeaderV1), static_cast<std::size_t>(header.used_bytes),
+                     static_cast<std::size_t>(header.reserved_bytes));
+        if (xbuf.arena()->used_end != header.used_bytes) throw XException("load_verified<T>(): non-normalized payload extent");
+        auto* root = xd::find_root<Root>(xbuf);
+        if (!root) throw XException("load_verified<T>(): root not found");
+        if (static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(root) -
+                reinterpret_cast<std::uintptr_t>(xbuf.get_address())) != header.root_offset)
+            throw XException("load_verified<T>(): root offset mismatch");
+        auto* state = xd::find_allocator_state(xbuf);
+        if (!state) throw XException("load_verified<T>(): allocator state not found");
+        if (static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(state) -
+                reinterpret_cast<std::uintptr_t>(xbuf.get_address())) != header.allocator_offset)
+            throw XException("load_verified<T>(): allocator offset mismatch");
+        result.emplace(Prepared{std::move(xbuf), nullptr});
+        result->root = xd::find_root<Root>(result->xbuf);
+    });
+    return result;
+}
+
+std::size_t fallback_count() {
+#if defined(XOFFSET_HAS_VALIDATION_GRANULE_FALLBACK_HOOK)
+    return xd::wire_validation_granule_fallbacks;
+#else
+    return 0;
+#endif
+}
+
+// ---------------------------------------------------------------- fixtures
+std::string text(std::mt19937_64& rng, std::size_t n) {
+    std::string s(n, 'a');
+    for (auto& c : s) c = static_cast<char>('a' + rng() % 26);
+    return s;
+}
+void fill_record(dt::Record& r, std::uint64_t id, std::mt19937_64& rng) {
+    r.id = id; r.revision = 1; r.score = static_cast<std::int64_t>(rng() % 100000) - 50000;
+    r.name = std::string_view(text(rng, 4 + rng() % 28));
+    const auto ns = rng() % 17;
+    for (std::size_t i = 0; i < ns; ++i) r.samples.push_back(static_cast<std::uint32_t>(rng()));
+    const auto np = rng() % 97;
+    r.payload.resize(np);
+    for (std::size_t i = 0; i < np; ++i) r.payload[i] = static_cast<std::uint8_t>(rng());
+    const auto na = 4 + rng() % 2;
+    r.attrs.resize(na);
+    for (std::size_t i = 0; i < na; ++i) {
+        r.attrs[i].key = std::string_view("k" + std::to_string(1000 + i));
+        const auto nv = rng() % 24;
+        for (std::size_t j = 0; j < nv; ++j) r.attrs[i].value.push_back(static_cast<std::uint8_t>(rng()));
+    }
+    r.flag = (rng() & 1) != 0;
+    const auto nt = rng() % 4;
+    for (std::size_t i = 0; i < nt; ++i)
+        r.tags.try_emplace(static_cast<std::int32_t>(rng() % 50) - 25, std::string_view(text(rng, 1 + rng() % 20)));
+    const auto nm = rng() % 6;
+    for (std::size_t i = 0; i < nm; ++i) r.marks.insert(static_cast<std::int32_t>(rng() % 1000));
+}
+
+std::string build_fixture(std::size_t records, std::uint64_t seed) {
+    std::mt19937_64 rng(seed);
+    auto buf = XBuffer::create<Root>(std::size_t{1} << 16,
+        XBuffer::maximum_capacity(std::size_t{256} << 20).with_growth(XGrowPolicy::Automatic));
+    auto& s = buf.root<Root>();
+    s.epoch = seed;
+    s.records.reserve(records);
+    for (std::size_t i = 0; i < records; ++i) fill_record(s.records.emplace_back(), 10 * i + 1, rng);
+    // Modification like the benchmark trace: longer names, appended samples,
+    // larger payloads, attribute updates and erased records leave free blocks.
+    for (std::size_t i = 0; i < records; ++i) {
+        auto& r = s.records[i];
+        switch (rng() % 5) {
+        case 0: r.name = std::string_view(text(rng, 64 + rng() % 65)); break;
+        case 1: for (int k = 0; k < 48; ++k) r.samples.push_back(static_cast<std::uint32_t>(rng())); break;
+        case 2: r.payload.resize(128 + rng() % 257); break;
+        case 3: if (r.attrs.size()) r.attrs[rng() % r.attrs.size()].value.resize(40 + rng() % 40); break;
+        default: r.score += 1; r.revision += 1; break;
+        }
+    }
+    std::size_t write = 0;
+    for (std::size_t read = 0; read < s.records.size(); ++read) {
+        if (read % 7 == 3) continue;
+        if (write != read) s.records[write] = std::move(s.records[read]);
+        ++write;
+    }
+    s.records.resize(write);
+    auto wire = buf.save_verified<Root>();
+    (void)XBuffer::load_verified<Root>(wire);
+    return wire;
+}
+
+// Wire-offset inventory of a valid fixture, from its typed graph.
+struct Head { std::size_t at; };            // wire offset of an XFixedString/XFixedVector head
+struct Alloc { std::size_t header; };       // wire offset of an AllocationHeader
+struct Inventory {
+    std::vector<Head> heads;
+    std::vector<Alloc> allocs;
+    std::vector<std::size_t> free_blocks;   // wire offsets of free block payloads
+    std::size_t allocator = 0, root = 0;
+};
+Inventory inventory(const std::string& wire) {
+    Inventory inv;
+    auto buf = XBuffer::load_verified<Root>(wire);
+    const auto* base = static_cast<const char*>(buf.get_address());
+    auto off = [&](const void* p) {
+        return wire_header + static_cast<std::size_t>(static_cast<const char*>(p) - base);
+    };
+    auto head = [&](const auto& h) {
+        inv.heads.push_back({off(&h)});
+        if (h.capacity_ != 0) {
+            const auto* data = reinterpret_cast<const char*>(&h.data_delta) + h.data_delta;
+            inv.allocs.push_back({off(data) - sizeof(XBufferCore::AllocationHeader)});
+        }
+    };
+    const auto& s = buf.root<Root>();
+    inv.root = off(&s);
+    inv.allocs.push_back({inv.root - sizeof(XBufferCore::AllocationHeader)});
+    head(s.records);
+    for (const auto& r : s.records) {
+        head(r.name); head(r.samples); head(r.payload); head(r.attrs); head(r.tags); head(r.marks);
+        for (const auto& a : r.attrs) { head(a.key); head(a.value); }
+        for (const auto& kv : r.tags) head(kv.second);
+    }
+    const auto h = rd<XWireHeaderV1>(wire, 0);
+    inv.allocator = wire_header + h.allocator_offset;
+    inv.allocs.push_back({inv.allocator - sizeof(XBufferCore::AllocationHeader)});
+    const auto state = rd<XAllocatorStateV1>(wire, inv.allocator);
+    for (auto first : state.freelist_head) {
+        std::uint32_t offset = first;
+        for (std::size_t guard = 0; offset != 0 && guard < 100000; ++guard) {
+            const auto at = inv.allocator + offset;
+            inv.free_blocks.push_back(at);
+            inv.allocs.push_back({at - sizeof(XBufferCore::AllocationHeader)});
+            offset = rd<std::uint32_t>(wire, at + offsetof(XOffsetDatastructure::fixed_detail::FreeBlockHeader, next_offset));
+        }
+    }
+    return inv;
+}
+
+// ---------------------------------------------------------------- mutations
+struct Mutator {
+    std::mt19937_64 rng;
+    const Inventory& inv;
+    std::size_t pick(std::size_t n) { return static_cast<std::size_t>(rng() % n); }
+    std::int64_t small_delta() {
+        static constexpr std::int64_t d[] = {1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 15, 16, 17, 24, 31, 32, 40, 64, 4096};
+        const auto v = d[pick(std::size(d))];
+        return (rng() & 1) ? v : -v;
+    }
+    template <typename T> void add(std::string& w, std::size_t at, std::int64_t delta) {
+        if (at + sizeof(T) > w.size()) return;
+        wr<T>(w, at, static_cast<T>(static_cast<std::int64_t>(rd<T>(w, at)) + delta));
+    }
+    void random_bits(std::string& w) {
+        const auto n = 1 + pick(3);
+        for (std::size_t i = 0; i < n; ++i) {
+            const auto at = wire_header + pick(w.size() - wire_header);
+            w[at] = static_cast<char>(w[at] ^ (1u << pick(8)));
+        }
+    }
+    void random_byte(std::string& w) {
+        const auto at = wire_header + pick(w.size() - wire_header);
+        w[at] = static_cast<char>(rng());
+    }
+    void head_edit(std::string& w) {
+        const auto at = inv.heads[pick(inv.heads.size())].at;
+        switch (pick(6)) {
+        case 0: add<std::int32_t>(w, at + offsetof(XFixedString, data_delta), small_delta()); break;
+        case 1: wr<std::int32_t>(w, at + offsetof(XFixedString, data_delta),
+                                 static_cast<std::int32_t>(static_cast<std::int64_t>(
+                                     inv.allocs[pick(inv.allocs.size())].header + 16) -
+                                     static_cast<std::int64_t>(at + offsetof(XFixedString, data_delta)))); break;
+        case 2: add<std::uint32_t>(w, at + offsetof(XFixedString, size_), small_delta()); break;
+        case 3: add<std::uint32_t>(w, at + offsetof(XFixedString, capacity_), small_delta()); break;
+        case 4: add<std::int32_t>(w, at + offsetof(XFixedString, arena_delta), small_delta()); break;
+        default: wr<std::uint32_t>(w, at + offsetof(XFixedString, capacity_), 0); break;
+        }
+    }
+    void header_edit(std::string& w) {
+        using H = XBufferCore::AllocationHeader;
+        const auto at = inv.allocs[pick(inv.allocs.size())].header;
+        switch (pick(7)) {
+        case 0: add<std::uint32_t>(w, at + offsetof(H, total_bytes), small_delta()); break;
+        case 1: add<std::uint32_t>(w, at + offsetof(H, user_bytes), small_delta()); break;
+        case 2: add<std::uint32_t>(w, at + offsetof(H, user_offset), small_delta()); break;
+        case 3: wr<std::uint32_t>(w, at + offsetof(H, alignment), std::uint32_t{1} << pick(6)); break;
+        default: {
+            // Consistent metadata with a changed length: non-multiples of 8
+            // exercise the byte-granular fallback (accepted or rejected).
+            const std::int64_t k = (pick(4) == 0) ? small_delta() : (1 + static_cast<std::int64_t>(pick(7))) * ((rng() & 1) ? 1 : -1);
+            add<std::uint32_t>(w, at + offsetof(H, user_bytes), k);
+            add<std::uint32_t>(w, at + offsetof(H, total_bytes), k);
+            break;
+        }
+        }
+    }
+    void freelist_edit(std::string& w) {
+        const auto state = inv.allocator;
+        const auto heads = state + offsetof(XAllocatorStateV1, freelist_head);
+        const auto classes = sizeof(XAllocatorStateV1::freelist_head) / sizeof(std::uint32_t);
+        using FB = XOffsetDatastructure::fixed_detail::FreeBlockHeader;
+        const bool have = !inv.free_blocks.empty();
+        switch (pick(7)) {
+        case 0: add<std::uint32_t>(w, heads + 4 * pick(classes), small_delta()); break;
+        case 1: if (have) wr<std::uint32_t>(w, heads + 4 * pick(classes),
+                    static_cast<std::uint32_t>(inv.free_blocks[pick(inv.free_blocks.size())] - state)); break;
+        case 2: if (have) add<std::uint32_t>(w, inv.free_blocks[pick(inv.free_blocks.size())] + offsetof(FB, next_offset), small_delta()); break;
+        case 3: if (have) add<std::uint32_t>(w, inv.free_blocks[pick(inv.free_blocks.size())] + offsetof(FB, block_bytes), small_delta()); break;
+        case 4: add<std::uint64_t>(w, state + offsetof(XAllocatorStateV1, free_bytes), small_delta()); break;
+        case 5: if (have) { // point a free block at a live allocation
+                    const auto live = inv.allocs[pick(inv.allocs.size())].header + 16;
+                    wr<std::uint32_t>(w, inv.free_blocks[pick(inv.free_blocks.size())] + offsetof(FB, next_offset),
+                                      static_cast<std::uint32_t>(live - state));
+                } break;
+        default: if (have) { // consistent free block resize (header + block + byte count)
+                    const auto fb = inv.free_blocks[pick(inv.free_blocks.size())];
+                    const std::int64_t k = small_delta();
+                    add<std::uint32_t>(w, fb + offsetof(FB, block_bytes), k);
+                    add<std::uint32_t>(w, fb - 16 + offsetof(XBufferCore::AllocationHeader, user_bytes), k);
+                    add<std::uint32_t>(w, fb - 16 + offsetof(XBufferCore::AllocationHeader, total_bytes), k);
+                    add<std::uint64_t>(w, state + offsetof(XAllocatorStateV1, free_bytes), k);
+                } break;
+        }
+    }
+    void extent_edit(std::string& w) {
+        // A non-multiple-of-8 payload extent, kept consistent in the wire and
+        // arena headers so that the pre-checks pass.
+        const auto k = static_cast<std::int64_t>(1 + pick(23));
+        const bool grow = (rng() & 1) != 0;
+        auto h = rd<XWireHeaderV1>(w, 0);
+        if (grow) w.append(static_cast<std::size_t>(k), static_cast<char>(pick(2) ? 0 : rng()));
+        else if (static_cast<std::size_t>(k) < w.size() - wire_header - 4096) w.resize(w.size() - static_cast<std::size_t>(k));
+        h.used_bytes = w.size() - wire_header;
+        if (h.reserved_bytes < h.used_bytes) h.reserved_bytes = h.used_bytes;
+        wr(w, 0, h);
+        wr<std::uint64_t>(w, wire_header + offsetof(XBufferCore::arena_header, used_end), h.used_bytes);
+    }
+    void mutate(std::string& w) {
+        const auto n = pick(5) == 0 ? 2 + pick(3) : 1;
+        for (std::size_t i = 0; i < n; ++i) {
+            switch (pick(16)) {
+            case 0: case 1: random_bits(w); break;
+            case 2: random_byte(w); break;
+            case 3: case 4: case 5: head_edit(w); break;
+            case 6: case 7: case 8: case 9: case 10: header_edit(w); break;
+            case 11: case 12: case 13: freelist_edit(w); break;
+            default: extent_edit(w); break;
+            }
+        }
+    }
+};
+
+struct Stats {
+    std::size_t cases = 0, accepted = 0, rejected = 0, precheck_rejected = 0, fallback_cases = 0,
+                fallback_accepted = 0, mismatches = 0;
+};
+
+void run_fixture(const char* name, const std::string& wire, std::size_t cases, std::uint64_t seed, Stats& total) {
+    const auto inv = inventory(wire);
+    need(!inv.free_blocks.empty(), std::string(name) + ": fixture has no free-list blocks");
+    Mutator m{std::mt19937_64(seed), inv};
+    Stats st;
+    std::vector<std::string> distinct;
+    for (std::size_t c = 0; c <= cases; ++c) {
+        std::string w = wire;
+        if (c != 0) m.mutate(w);   // case 0: the unmodified valid fixture
+        const auto full = capture([&] { (void)XBuffer::load_verified<Root>(w); });
+        Outcome pre;
+        auto prepared = prepare(w, pre);
+        ++st.cases;
+        if (!prepared) {
+            ++st.precheck_rejected;
+            if (!(pre == full)) { ++st.mismatches; std::cerr << name << " case " << c << " precheck " << show(pre) << " vs load " << show(full) << '\n'; }
+            continue;
+        }
+        const auto before = fallback_count();
+        const auto mine = capture([&] { xd::verify_structural_wire_graph(*prepared->root, prepared->xbuf); });
+        const bool fell_back = fallback_count() != before;
+        const auto ref = capture([&] { xd::w9a_reference::verify_structural_wire_graph(*prepared->root, prepared->xbuf); });
+        if (!(mine == ref) || !(mine == full)) {
+            ++st.mismatches;
+            std::cerr << name << " case " << c << ": new " << show(mine) << " | reference " << show(ref)
+                      << " | load_verified " << show(full) << '\n';
+        }
+        if (ref.kind == 0) ++st.accepted; else ++st.rejected;
+        if (fell_back) { ++st.fallback_cases; if (ref.kind == 0) ++st.fallback_accepted; }
+        if (ref.kind != 0 && distinct.size() < 64) {
+            bool seen = false;
+            for (const auto& d : distinct) seen = seen || d == ref.text;
+            if (!seen) distinct.push_back(ref.text);
+        }
+        if (c == 0) need(ref.kind == 0, std::string(name) + ": valid fixture rejected: " + show(ref));
+    }
+    std::cout << name << ": wire_bytes=" << wire.size() << " cases=" << st.cases << " accepted=" << st.accepted
+              << " rejected=" << st.rejected << " precheck_rejected=" << st.precheck_rejected
+              << " fallback=" << st.fallback_cases << " fallback_accepted=" << st.fallback_accepted
+              << " distinct_errors=" << distinct.size() << " mismatches=" << st.mismatches << '\n';
+    total.cases += st.cases; total.accepted += st.accepted; total.rejected += st.rejected;
+    total.precheck_rejected += st.precheck_rejected; total.fallback_cases += st.fallback_cases;
+    total.fallback_accepted += st.fallback_accepted; total.mismatches += st.mismatches;
