+// B1 host page: every non-empty reservation (fresh PROT_NONE, full copy,
+// receive, pooled reuse) has a read/write owner slot just before data(),
+// begun null, outside the payload accounting, and moving with the storage.
+void test_host_page_owner_slot() {
+    using Slot = std::atomic<void*>;
+    auto slot = [](const VirtualMemoryStorage& s) { return VirtualMemoryStorage::owner_slot(s.data()); };
+    int marker = 0;
+    {
+        VirtualMemoryStorage s(0, 1 << 20);
+        check(slot(s)->load() == nullptr, "fresh owner slot not null");
+        slot(s)->store(&marker);
+        check(s.reserved_bytes() == (std::size_t(1) << 20) && s.accessible_bytes() == 0,
+              "host page counted in payload accounting");
+        VirtualMemoryStorage moved(std::move(s));
+        check(slot(moved)->load() == &marker, "owner slot did not move with the storage");
+        slot(moved)->store(nullptr);
+    }
+    {
+        std::vector<char> full(64 << 10, 'q');
+        auto f = VirtualMemoryStorage::from_bytes(full.data(), full.size(), full.size());
+        check(slot(f)->load() == nullptr && f.accessible_bytes() == f.reserved_bytes(),
+              "full-copy storage owner slot");
+        auto r = VirtualMemoryStorage::for_receive(16, 1 << 20);
+        check(slot(r)->load() == nullptr, "receive storage owner slot");
+    }
+    {
+        VmStoragePool pool({1, 4 << 20, 4 << 20});
+        const char* base = nullptr;
+        { VirtualMemoryStorage a(0, 1 << 20, pool); base = a.data(); check(slot(a)->load() == nullptr, "pooled slot"); }
+        VirtualMemoryStorage b(0, 1 << 20, pool);
+        check(b.data() == base && slot(b)->load() == nullptr && pool.stats().hits == 1,
+              "pooled reuse lost the host page");
+    }
+    static_assert(std::is_same<decltype(VirtualMemoryStorage::owner_slot(nullptr)), Slot*>::value, "slot type");
+}
