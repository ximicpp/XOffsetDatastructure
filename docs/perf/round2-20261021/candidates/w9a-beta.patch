+void leaf_aggregate_owns_and_moves() {
+    static_assert(fixed_detail::owns_leaf_aggregate<LeafPair>());
+    static_assert(!fixed_detail::owns_leaf_aggregate<MoveRecord>()); // labels: XVector<XString>
+    auto buffer = XBuffer::create<LeafRoot>(1024u * 1024u, policy()); auto& r = buffer.root<LeafRoot>();
+    r.pairs.resize(5);
+    for (std::uint32_t i = 0; i < 5; ++i) {
+        r.pairs[i].id = i; r.pairs[i].key.assign(std::string(9 + i, char('a' + i)));
+        r.pairs[i].value.resize(16 + i); r.pairs[i].value[0] = std::uint8_t(i);
+    }
+    auto window = [](const void* data, std::size_t n) {
+        auto* p = static_cast<const unsigned char*>(data);
+        return std::pair{p - 24, p + n + 24};
+    };
+    { auto [lo, hi] = window(r.pairs.data(), r.pairs.capacity() * sizeof(LeafPair)); owns_equivalence_for(r.pairs, lo, hi); }
+    for (std::uint32_t i = 0; i < 5; ++i) {
+        { auto [lo, hi] = window(r.pairs[i].key.data(), r.pairs[i].key.capacity() + 1u); owns_equivalence_for(r.pairs, lo, hi); }
+        { auto [lo, hi] = window(r.pairs[i].value.data(), r.pairs[i].value.capacity()); owns_equivalence_for(r.pairs, lo, hi); }
+    }
+    owns_equivalence_for(r.other, reinterpret_cast<const unsigned char*>(&r), reinterpret_cast<const unsigned char*>(&r) + 64);
+    auto* storage = r.pairs.data();
+    r.other = std::move(r.pairs);
+    require(r.other.data() == storage && r.other.size() == 5 && r.other[4].key.view() == std::string(13, 'e') &&
+        r.pairs.data() == nullptr, "leaf aggregate vector transfer");
+    // Descendant destination inside an element's value buffer: copy fallback.
+    auto* inner = std::construct_at(reinterpret_cast<XFixedVector<LeafPair>*>(r.other[4].value.data()), r.other.binding());
+    *inner = std::move(r.other);
+    require(r.other.data() == storage && inner->data() != storage && inner->size() == 5,
+        "leaf aggregate descendant destination stole its own owning allocation");
+    std::destroy_at(inner);
+    ++cases;
+}
