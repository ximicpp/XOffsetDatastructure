+void second_member_alias_guards() {
+    auto build = [](PairTree& r) {
+        r.nodes.resize(2); r.nodes[0].id = 1; r.nodes[0].key.assign("first-key");
+        r.nodes[0].kids.resize(1); r.nodes[0].kids[0].id = 2; r.nodes[0].kids[0].key.assign("child-key");
+        r.nodes[0].kids[0].kids.resize(1); r.nodes[0].kids[0].kids[0].id = 3;
+        r.nodes[1].id = 4; r.nodes[1].key.assign("second-key");
+    };
+    {   // destination lives in the source's tree only through member #2 (kids)
+        auto buffer = XBuffer::create<PairTree>(1024u * 1024u, policy()); auto& r = buffer.root<PairTree>(); build(r);
+        auto* outer = r.nodes.data(); auto& deep = r.nodes[0].kids[0].kids;
+        deep = std::move(r.nodes);
+        require(r.nodes.data() == outer && r.nodes.size() == 2 && r.nodes[1].key.view() == "second-key",
+            "second-member descendant destination stole its own owning allocation");
+        require(deep.size() == 2 && deep.data() != outer && deep[0].key.view() == "first-key" &&
+            deep[0].kids.size() == 1 && deep[0].kids[0].id == 2 && deep[1].id == 4,
+            "second-member descendant fallback failed finite deep copy");
+    }
+    {   // source lives in the destination's tree only through member #2 (kids)
+        auto buffer = XBuffer::create<PairTree>(1024u * 1024u, policy()); auto& r = buffer.root<PairTree>(); build(r);
+        auto& deep = r.nodes[0].kids[0].kids; auto* inner = deep.data();
+        r.nodes = std::move(deep);
+        require(r.nodes.size() == 1 && r.nodes[0].id == 3 && r.nodes.data() != inner,
+            "second-member ancestor destination failed copy-before-retire fallback");
+    }
+    ++cases;
