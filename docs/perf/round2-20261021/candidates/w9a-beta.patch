+// B2: the default-scalar reallocation branch value-initializes the new tail
+// in one call. Reused (dirty) free-list storage must still read zero, the old
+// prefix must survive, and the old storage must be retired.
+void scalar_reallocation_value_initializes() {
+    auto b = make_buffer(); auto& r = b.root<ResizeRoot>();
+    for (std::uint32_t round = 0; round < 64; ++round) {
+        auto& v = r.numbers;
+        v.clear(); std::destroy_at(&v); std::construct_at(&v, r.attrs.binding());
+        v.resize(3); v[0] = 7 + round; v[1] = 8; v[2] = 9;
+        // Leave a dirty block of the target size class on the free list.
+        auto* dirty = fd::allocate_dynamic_bytes(v.binding(), (6 + round % 5) * 4, alignof(std::uint32_t));
+        std::memset(dirty, 0xee, (6 + round % 5) * 4);
+        fd::retire_dynamic_bytes(v.binding(), dirty, (6 + round % 5) * 4);
+        r.late.resize(r.late.size() + 1); // keep v's storage away from the arena tail
+        const auto free_before = v.allocator_state()->free_bytes;
+        v.resize(6 + round % 5);
+        need(v.size() == 6 + round % 5 && v.capacity() == v.size(), "scalar reallocation extent");
+        need(v[0] == 7 + round && v[1] == 8 && v[2] == 9, "scalar reallocation lost the prefix");
+        for (std::uint32_t i = 3; i < v.size(); ++i) need(v[i] == 0, "scalar reallocation tail not value-initialized");
+        (void)free_before;
+    }
+    roundtrip(b); ++cases;
+}
+
+// B3 (not adopted): "capacity_ > 0 implies bound with a non-null arena" is
+// FALSE for publicly reachable states, so an in-capacity push_back may not
+// skip ensure_bound(). Pin the existing first error for both counterexamples.
+void in_capacity_push_back_keeps_bound_check() {
+    auto b = make_buffer(); auto& r = b.root<ResizeRoot>(); auto& v = r.numbers;
+    v.reserve(8); v.push_back(1);
+    auto expect_unbound = [&](const char* why) {
+        bool hit = false;
+        try { v.push_back(2); }
+        catch (const xo::XException& e) { hit = std::string_view(e.what()) == "XFixedVector is not bound to an allocator"; }
+        need(hit && v.size() == 1 && v[0] == 1, why);
+    };
+    const auto original = v.binding();
+    v.bind(fd::allocator_ref{});              // public rebind to a null binding, storage kept
+    need(v.capacity() == 8 && v.is_bound() && v.arena() == nullptr, "counterexample 1 state");
+    expect_unbound("in-capacity push_back skipped the null-arena check");
+    auto* second = static_cast<xo::XAllocatorStateV1*>(b.arena()->allocate_aligned(sizeof(xo::XAllocatorStateV1), alignof(xo::XAllocatorStateV1)));
+    std::construct_at(second); fd::initialize_allocator_state(*second, nullptr);
+    v.bind(fd::allocator_ref_of(second));     // state bound, but the state has no segment
+    need(v.capacity() == 8 && v.allocator_state() == second && v.arena() == nullptr, "counterexample 2 state");
+    expect_unbound("in-capacity push_back skipped the state-without-segment check");
+    v.bind(original);
+    v.push_back(3); need(v.size() == 2 && v[1] == 3, "rebinding the original allocator restores push_back");
+    ++cases;
+}
