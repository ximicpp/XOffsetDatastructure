+void moved_from_release_is_inert() {
+    auto buffer = make_buffer(); auto& r = buffer.root<MoveRoot>();
+    r.right.assign("x-source"); r.b.push_back(5); r.left.assign("y"); r.a.push_back(6);
+    r.left = std::move(r.right); r.a = std::move(r.b);          // right/b are now moved-from
+    auto* state = r.left.allocator_state(); require(state != nullptr, "missing allocator state");
+    const auto free_before = state->free_bytes; const auto epoch_before = state->epoch;
+    const auto sb = r.right.binding(), vb = r.b.binding();
+    r.records.resize(2);                                       // two empty in-arena records
+    const auto free_empty = state->free_bytes; const auto epoch_empty = state->epoch;
+    r.records[0].name = std::move(r.right); r.records[0].values = std::move(r.b);   // empty <- moved-from
+    r.right = std::move(r.records[1].name); r.b = std::move(r.records[1].values);   // moved-from <- empty
+    require(state->free_bytes == free_empty && state->epoch == epoch_empty,
+        "moved-from/empty in-arena move retired or touched allocator state");
+    require_empty_reusable_binding(r.right, sb); require_empty_reusable_binding(r.b, vb);
+    require(free_before <= free_empty && epoch_before <= epoch_empty, "allocator state regressed");
+    // Compaction into moved-from slots: only the one live destination retires.
+    r.records.resize(0); r.records.resize(4);
+    for (std::uint32_t i = 0; i < 4; ++i) fill(r.records[i], 50 + i);
+    r.records[0] = std::move(r.records[1]);                    // live destination: retires its payloads
+    const auto epoch_live = state->epoch;
+    r.records[1] = std::move(r.records[2]);                    // moved-from destination: no retire
+    r.records[2] = std::move(r.records[3]);
+    require(state->epoch == epoch_live, "moved-from destinations retired payloads");
+    check(r.records[0], 51); check(r.records[1], 52); check(r.records[2], 53);
+    r.records.resize(3);                                       // destroys a moved-from record
+    require(state->epoch == epoch_live, "destroying a moved-from record retired payloads");
+    verified_roundtrip(buffer); ++cases;
+}
