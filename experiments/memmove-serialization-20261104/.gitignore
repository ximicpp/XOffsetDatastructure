!baseline.json
!progress.json
!checks.json
!release.xml
!asan.xml
!ir-audit*.json
!review-evidence.zip
!review-manifest.json
!measurement-v1/
!measurement-v1/*.json
!measurement-v1/*.stderr
!measurement-v2-borrowed/
!measurement-v2-borrowed/*.json
!measurement-v2-borrowed/*.stderr
!baseline-asan-control/
!baseline-asan-control/result.json
!baseline-asan-control/test_verified_paths.cpp
