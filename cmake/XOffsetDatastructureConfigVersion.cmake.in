# Stable releases follow Semantic Versioning (SameMajorVersion: any request of
# the same major version at or below the installed numeric version is accepted,
# and version ranges are checked against the numeric version). Prereleases
# refuse all numeric, EXACT and range requests so a prerelease is never taken
# for a stable version; discover unversioned and compare
# XOffsetDatastructure_VERSION with STREQUAL.
set(PACKAGE_VERSION "@XOFFSET_VERSION_FULL@")
set(PACKAGE_VERSION_EXACT FALSE)
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_UNSUITABLE FALSE)

if("@XOFFSET_IS_PRERELEASE@" STREQUAL "TRUE")
    if(NOT "${PACKAGE_FIND_VERSION}" STREQUAL "" OR NOT "${PACKAGE_FIND_VERSION_RANGE}" STREQUAL "")
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
        set(PACKAGE_VERSION_UNSUITABLE TRUE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
elseif(NOT "${PACKAGE_FIND_VERSION_RANGE}" STREQUAL "")
    if(NOT "@XOFFSET_VERSION_NUMERIC@" VERSION_LESS "${PACKAGE_FIND_VERSION_MIN}")
        if("${PACKAGE_FIND_VERSION_RANGE_MAX}" STREQUAL "INCLUDE")
            if(NOT "@XOFFSET_VERSION_NUMERIC@" VERSION_GREATER "${PACKAGE_FIND_VERSION_MAX}")
                set(PACKAGE_VERSION_COMPATIBLE TRUE)
            endif()
        else()
            if("@XOFFSET_VERSION_NUMERIC@" VERSION_LESS "${PACKAGE_FIND_VERSION_MAX}")
                set(PACKAGE_VERSION_COMPATIBLE TRUE)
            endif()
        endif()
    endif()
    if(NOT PACKAGE_VERSION_COMPATIBLE)
        set(PACKAGE_VERSION_UNSUITABLE TRUE)
    endif()
elseif(NOT "${PACKAGE_FIND_VERSION}" STREQUAL "")
    if(PACKAGE_FIND_VERSION_COUNT LESS_EQUAL 3
       AND PACKAGE_FIND_VERSION_MAJOR EQUAL @XOFFSET_VERSION_MAJOR@
       AND NOT "@XOFFSET_VERSION_NUMERIC@" VERSION_LESS "${PACKAGE_FIND_VERSION}")
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
        if("@XOFFSET_VERSION_NUMERIC@" VERSION_EQUAL "${PACKAGE_FIND_VERSION}")
            set(PACKAGE_VERSION_EXACT TRUE)
        endif()
    else()
        set(PACKAGE_VERSION_UNSUITABLE TRUE)
    endif()
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
