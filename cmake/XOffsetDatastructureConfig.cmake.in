@PACKAGE_INIT@
set(XOffsetDatastructure_VERSION "@XOFFSET_VERSION_FULL@")
set(XOffsetDatastructure_VERSION_NUMERIC "@XOFFSET_VERSION_NUMERIC@")
set(XOffsetDatastructure_VERSION_PRERELEASE "@XOFFSET_VERSION_PRERELEASE@")
set(XOffsetDatastructure_IS_PRERELEASE TRUE)
set(XOffsetDatastructure_VERSION_COMPATIBILITY "exact-full-version-only")
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(XOffsetDatastructure_FOUND TRUE)
set(XOffsetDatastructure_storage_FOUND TRUE)
set(XOffsetDatastructure_full_FOUND @XOFFSET_HAS_FULL@)
set(XOffsetDatastructure_ValidationScratch_FOUND @XOFFSET_HAS_VALIDATION_SCRATCH@)
set(XOffsetDatastructure_snapshot_index_runtime_FOUND @XOFFSET_HAS_SNAPSHOT_INDEX_RUNTIME@)
if(NOT XOffsetDatastructure_FIND_COMPONENTS)
    set(XOffsetDatastructure_FIND_COMPONENTS full)
    set(XOffsetDatastructure_FIND_REQUIRED_full TRUE)
endif()
if("full" IN_LIST XOffsetDatastructure_FIND_COMPONENTS)
    if(NOT XOffsetDatastructure_full_FOUND)
        set(XOffsetDatastructure_NOT_FOUND_MESSAGE "This is a storage-only installation; request COMPONENTS storage or install the full package.")
    elseif(CMAKE_VERSION VERSION_LESS 3.30)
        set(XOffsetDatastructure_full_FOUND FALSE)
        set(XOffsetDatastructure_NOT_FOUND_MESSAGE "The full C++26 target requires CMake 3.30 or newer.")
    elseif(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        set(XOffsetDatastructure_full_FOUND FALSE)
        set(XOffsetDatastructure_NOT_FOUND_MESSAGE "The full target requires an experimental P2996 Clang and matching libc++.")
    endif()
endif()
check_required_components(XOffsetDatastructure)
if(XOffsetDatastructure_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/XOffsetTargets.cmake")
endif()
