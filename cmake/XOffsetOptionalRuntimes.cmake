# Explicit opt-in; old full/storage consumers gain no compiled dependency.
option(XOFFSET_BUILD_VALIDATION_SCRATCH_RUNTIME "Build optional shared validation scratch" OFF)
option(XOFFSET_BUILD_SNAPSHOT_INDEX_RUNTIME "Build optional shared snapshot index budget" OFF)
set(XOFFSET_HAS_VALIDATION_SCRATCH OFF)
set(XOFFSET_HAS_SNAPSHOT_INDEX_RUNTIME OFF)
if(XOFFSET_STORAGE_ONLY AND (XOFFSET_BUILD_VALIDATION_SCRATCH_RUNTIME OR XOFFSET_BUILD_SNAPSHOT_INDEX_RUNTIME))
    message(FATAL_ERROR "Optional production runtimes require the full source component")
endif()
if(XOFFSET_BUILD_VALIDATION_SCRATCH_RUNTIME)
    add_library(xoffset_validation_scratch SHARED "${PROJECT_SOURCE_DIR}/validation_scratch.cpp")
    add_library(XOffset::ValidationScratch ALIAS xoffset_validation_scratch)
    set_target_properties(xoffset_validation_scratch PROPERTIES EXPORT_NAME ValidationScratch)
    target_compile_definitions(xoffset_validation_scratch PRIVATE XOFFSET_SCRATCH_BUILDING_LIBRARY=1)
    set(XOFFSET_HAS_VALIDATION_SCRATCH ON)
endif()
if(XOFFSET_BUILD_SNAPSHOT_INDEX_RUNTIME)
    add_library(xoffset_snapshot_index_runtime SHARED "${PROJECT_SOURCE_DIR}/snapshot_index_runtime.cpp")
    add_library(XOffset::snapshot_index_runtime ALIAS xoffset_snapshot_index_runtime)
    set_target_properties(xoffset_snapshot_index_runtime PROPERTIES EXPORT_NAME snapshot_index_runtime)
    target_compile_definitions(xoffset_snapshot_index_runtime PRIVATE XOFFSET_SNAPSHOT_INDEX_RUNTIME_BUILD=1
        PUBLIC XOFFSET_SNAPSHOT_INDEX_SHARED_RUNTIME=1)
    set(XOFFSET_HAS_SNAPSHOT_INDEX_RUNTIME ON)
endif()
foreach(runtime IN ITEMS xoffset_validation_scratch xoffset_snapshot_index_runtime)
    if(TARGET ${runtime})
        target_compile_features(${runtime} PUBLIC cxx_std_17)
        target_link_libraries(${runtime} PUBLIC Threads::Threads)
        target_include_directories(${runtime} PUBLIC $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}>)
        set_target_properties(${runtime} PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
    endif()
endforeach()
