include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/XOffsetDependencyLock.cmake")

# Validate bytes rather than requiring .git metadata in a source archive. The
# lock names the upstream revisions and fixes every distributed include tree.
# TypeLayout serves only the C++26 build (reflection signatures and tools);
# the C++20/C++23 builds neither need nor ship it.
function(xoffset_validate_dependencies)
    set(with_typelayout OFF)
    if(XOFFSET_CXX_STANDARD STREQUAL "26")
        set(with_typelayout ON)
    endif()
    set(dependency_manifest "Boost ${XOFFSET_BOOST_REVISION}\n")
    if(with_typelayout)
        string(APPEND dependency_manifest "TypeLayout ${XOFFSET_TYPELAYOUT_REVISION}\n")
    endif()
    set(boost_dirs "")
    foreach(entry IN LISTS XOFFSET_DEPENDENCY_TREES)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 relative_tree)
        list(GET fields 1 expected_hash)
        if(NOT with_typelayout AND relative_tree MATCHES "^external/typelayout/")
            continue()
        endif()
        set(tree "${PROJECT_SOURCE_DIR}/${relative_tree}")
        file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${tree}" "${tree}/*")
        list(SORT files)
        set(records "")
        foreach(relative_file IN LISTS files)
            file(SHA256 "${tree}/${relative_file}" hash)
            string(APPEND records "${relative_file} ${hash}\n")
        endforeach()
        string(SHA256 actual_hash "${records}")
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Pinned dependency content mismatch: ${relative_tree}. Restore the dependencies recorded in cmake/XOffsetDependencyLock.cmake.")
        endif()
        string(APPEND dependency_manifest "\n[${relative_tree}] ${actual_hash}\n${records}")
        if(relative_tree MATCHES "external/boost/")
            list(APPEND boost_dirs "${tree}")
        endif()
    endforeach()
    foreach(entry IN LISTS XOFFSET_DEPENDENCY_LICENSES)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 relative_file)
        list(GET fields 1 expected_hash)
        if(NOT with_typelayout AND relative_file MATCHES "^external/typelayout/")
            continue()
        endif()
        if(NOT EXISTS "${PROJECT_SOURCE_DIR}/${relative_file}")
            message(FATAL_ERROR "Missing required dependency license: ${relative_file}")
        endif()
        file(SHA256 "${PROJECT_SOURCE_DIR}/${relative_file}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Pinned dependency license mismatch: ${relative_file}")
        endif()
        string(APPEND dependency_manifest "${relative_file} ${actual_hash}\n")
    endforeach()
    file(WRITE "${PROJECT_BINARY_DIR}/xoffset-third-party-manifest.txt" "${dependency_manifest}")
    set(BOOST_INCLUDE_DIRS "${boost_dirs}" PARENT_SCOPE)
    if(with_typelayout)
        set(TYPELAYOUT_INCLUDE_DIRS "${PROJECT_SOURCE_DIR}/external/typelayout/include" PARENT_SCOPE)
    else()
        set(TYPELAYOUT_INCLUDE_DIRS "" PARENT_SCOPE)
    endif()
endfunction()
